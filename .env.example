# ==========================================
# HARDWARE SHOP MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/hardwareshop_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hardwareshop_db

# JWT Stateless Authentication (Min 256-bit base64 secret)
JWT_SECRET=dGhpc0lzQVZlcnlTZWN1cmVTZWNyZXRLZXlGb3JTYWxlc0hhcmR3YXJlU2hvcEFwcGxpY2F0aW9uMjAyNg==
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ==========================================
# REAL NOTIFICATION PROVIDER CONFIGURATION
# Options: twilio | meta | rest | mock
# ==========================================
NOTIFICATION_PROVIDER=twilio
ADMIN_ALERT_PHONE=+919876543210

# Option 1: Official Twilio Messages API (WhatsApp + SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=+14155238886

# Option 2: Meta WhatsApp Cloud API v20.0 (Official Graph API)
WHATSAPP_API_KEY=EAA...your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000

# Option 3: Generic REST Webhook Gateway (Fallback)
WHATSAPP_API_URL=https://api.yourprovider.com/v1/whatsapp/send
SMS_API_URL=https://api.yourprovider.com/v1/sms/send
SMS_API_KEY=your_sms_provider_token_here

# Store Business Information (Included on GST Tax Invoices)
SHOP_NAME=Apex Hardware & Industrial Supplies
SHOP_CONTACT=+91 98765 43210
SHOP_ADDRESS=104 Industrial Area, Peenya Phase 2, Bengaluru, Karnataka 560058

# Local/Container Upload Storage Directory
STORAGE_UPLOAD_DIR=uploads/products
